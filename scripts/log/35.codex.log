    "ultimateOrigin": "ar",
    "chain": [
      {"language": "ar", "form": "ḥaraḳa", "meaning": "ateşle yaktı", "period": null, "reconstructed": false},
      {"language": "ar", "form": "muḥriḳ", "meaning": "yanmaya yol açan", "period": null, "reconstructed": false},
