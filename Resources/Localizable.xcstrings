    "settings.sources.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Etymologies are compiled mainly from Nişanyan Sözlük, the Turkish Language Association's Güncel Türkçe Sözlük, Kubbealtı Lugatı and Andreas Tietze's Tarihî ve Etimolojik Türkiye Türkçesi Lugati. The sources used for each entry are listed beneath that entry."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Köken bilgileri başlıca Nişanyan Sözlük, Türk Dil Kurumu Güncel Türkçe Sözlük, Kubbealtı Lugatı ve Andreas Tietze'nin Tarihî ve Etimolojik Türkiye Türkçesi Lugati kaynaklarından derlenir. Her maddede kullanılan kaynaklar maddenin altında ayrıca listelenir."
          }
        }
      }
    },
